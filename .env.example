# HousePlus - Environment Variables
# Copy this file to .env and fill in the values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.houseplus-ch.com
NEXT_PUBLIC_SITE_NAME=HousePlus

# Storyblok CMS
NEXT_PUBLIC_STORYBLOK_TOKEN=your_storyblok_token_here

# Email (Resend) - Optional
RESEND_API_KEY=your_resend_api_key_here

# Vercel Analytics (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Google Merchant Center (自动化管理)
GOOGLE_MERCHANT_ID=575397679
GOOGLE_SERVICE_ACCOUNT={"client_email":"xxx@xxx.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# 说明:
# - GOOGLE_MERCHANT_ID: 在 MC 后台 URL 中找到 (a=后面的数字)
# - GOOGLE_SERVICE_ACCOUNT: Google Cloud Console > IAM > Service Accounts > 创建 JSON 密钥
# - 配置后运行: npm run mc:status 验证
