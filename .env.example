# ============================================================================
# HousePlus SEO Optimization — Environment Variables Template
# Updated: 2026-07-28
#
# INSTRUCTIONS:
#   1. Copy this file to `.env.local` (Next.js auto-loads it for local dev).
#   2. Copy to `.env.production` for production build secrets.
#   3. NEVER commit `.env.local` or `.env.production` to version control.
#   4. Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#      Keep all secret keys (IndexNow key file content is public, but the API
#      tokens below) server-side only (no NEXT_PUBLIC_ prefix).
#
# In Vercel/Netlify, add these in the project dashboard under Environment
# Variables. Variables without NEXT_PUBLIC_ are only available in API routes
# and getServerSideProps/getStaticProps (server-side).
# ============================================================================

# === Site Configuration ===
# Canonical site URL (no trailing slash). Used for sitemaps, canonical tags,
# hreflang, structured data. Must match the production domain.
NEXT_PUBLIC_SITE_URL=https://www.houseplus-ch.com

# CDN hostname for product/factory images.
NEXT_PUBLIC_CDN_URL=https://images.houseplus-ch.com

# === Google Search Console Verification ===
# Content attribute of: <meta name="google-site-verification" content="XXXX" />
# Obtain from Google Search Console > Settings > Ownership verification.
NEXT_PUBLIC_GSC_VERIFICATION=

# === Google Analytics 4 (GA4) ===
# Measurement ID, format "G-XXXXXXXXXX". Loaded in _app.tsx.
NEXT_PUBLIC_GA_ID=

# === Bing Webmaster Tools Verification ===
# Content attribute of: <meta name="msvalidate.01" content="XXXX" />
NEXT_PUBLIC_BING_VERIFICATION=

# === Yandex Webmaster Verification ===
# Content attribute of: <meta name="yandex-verification" content="XXXX" />
NEXT_PUBLIC_YANDEX_VERIFICATION=

# === Baidu Site Verification (for Chinese market SEO) ===
# Content attribute of: <meta name="baidu-site-verification" content="XXXX" />
NEXT_PUBLIC_BAIDU_VERIFICATION=

# === IndexNow (instant index submission for Bing/Yandex/Naver) ===
# A random key string (16-128 hex chars). The SAME key must also be served at
# https://www.houseplus-ch.com/<INDEXNOW_KEY>.txt — see public/ for the file.
# Used by /api/indexnow to submit URLs the moment they are published/updated.
INDEXNOW_KEY=
# Comma-separated list of IndexNow endpoints to submit to (optional override).
# Defaults to https://api.indexnow.org/indexnow plus search-engine endpoints.
INDEXNOW_ENDPOINTS=https://api.indexnow.org/indexnow,https://www.bing.com/indexnow,https://yandex.com/indexnow

# === Google Search Console API (for programmatic ranking/coverage reports) ===
# Used by /api/gsc-reports and the monitoring scripts in docs/.
# Create OAuth2 credentials or a service account in Google Cloud Console.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_PROPERTY_ID=

# === Sitemap ping endpoints (optional) ===
# Where to ping when the sitemap is regenerated. Defaults built into the app.
SITEMAP_PING_URLS=https://www.google.com/ping?sitemap=,https://www.bing.com/ping?sitemap=

# === Open Graph Image Generation (@vercel/og) ===
# Optional override for the default brand background color hex (no #).
OG_DEFAULT_BG=
# Optional override for the brand logo text shown on generated OG images.
OG_LOGO_TEXT=HousePlus

# === Contact Form / Lead Capture ===
# reCAPTCHA v3 keys (server-side verification on /api/contact).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# === Email / SMTP (transactional + lead notifications) ===
# Used by /api/contact to email sales when a quote request arrives.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HousePlus Sales <jack@houseplus-ch.com>"
SALES_NOTIFY_EMAIL=jack@houseplus-ch.com

# === Search backend (optional) ===
# Algolia credentials power the client-side search index. If left blank, the
# search page falls back to the static product dataset bundled at build time.
NEXT_PUBLIC_ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=houseplus_products

# === Error / Performance Monitoring (optional) ===
# Sentry DSN. If set, enable Sentry in next.config.js / instrumentation.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# VERCEL analytics token (auto when deployed on Vercel; set manually otherwise).
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# === Web Vitals reporting endpoint (optional override) ===
# The WebVitals component POSTs metrics here. Defaults to "/api/web-vitals".
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=/api/web-vitals

# === CMS / data source (optional) ===
# If products/blog posts come from a headless CMS (e.g. Sanity, Strapi, Contentful).
CMS_API_URL=
CMS_API_TOKEN=

# === Build-time feature flags ===
# Set to "1" to enable verbose SEO/structured-data validation logs during build.
SEO_DEBUG=0
